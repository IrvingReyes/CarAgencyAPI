# Copy to .env and adjust. Default points to the Postgres container from docker-compose.
DATABASE_URL=postgresql+psycopg://car_agency:car_agency@localhost:5433/car_agency

# JWT signing key. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial API user, created on startup if it does not exist
FIRST_USER_EMAIL=odoo@example.com
FIRST_USER_PASSWORD=change-me
